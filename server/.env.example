# Copy this file to server/.env and fill in your own values.
# Never commit server/.env; it is ignored by .gitignore.
TINYFISH_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ETH_RPC_URL=
ETHERSCAN_API_KEY=
PORT=3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
COMMUNITY_ADMIN_TOKEN=
COMMUNITY_HASH_SECRET=
# Set 1 for the Vercel proxy, or configure the trusted proxy hop count for your host.
TRUST_PROXY_HOPS=
# Optional override for the TinyFish request timeout in milliseconds (default 8000).
TINYFISH_TIMEOUT_MS=
# Optional override for the Google Safe Browsing timeout in milliseconds (default 6000).
GOOGLE_SAFE_BROWSING_TIMEOUT_MS=
# Optional override for each Ethereum JSON-RPC request timeout in milliseconds (default 6000).
ETH_RPC_TIMEOUT_MS=
# Optional override for each Etherscan request timeout in milliseconds (default 6000).
ETHERSCAN_TIMEOUT_MS=
