{
  "manifest_version": 3,
  "name": "ChainShield",
  "version": "0.1.0",
  "description": "A demo interface for evidence-based Web3 website risk investigation.",
  "icons": {
    "16": "icons/shield-16.png",
    "32": "icons/shield-32.png",
    "48": "icons/shield-48.png",
    "128": "icons/shield-128.png"
  },
  "action": {
    "default_title": "ChainShield",
    "default_icon": {
      "16": "icons/shield-16.png",
      "32": "icons/shield-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": ["http://localhost/*"]
}
