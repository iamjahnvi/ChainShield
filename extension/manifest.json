{
  "manifest_version": 3,
  "name": "ChainShield",
  "version": "0.1.0",
  "description": "A demo interface for evidence-based Web3 website risk investigation.",
  "action": {
    "default_title": "ChainShield"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": ["http://localhost/*"]
}
